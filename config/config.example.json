{
  "mode": "html",
  "baseUrl": "https://journals.sagepub.com",
  "selector": "div.col-12.col-lg-8",
  "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
  "outputDir": "./output",
  "assetsPath": "assets",
  "exceptionsPath": "known_exceptions.yaml",
  "journalSource": {
    "host": "sftp2.literatumonline.com",
    "port": 22,
    "username": "",
    "keyFilename": "",
    "remoteDir": "/sage/mddb/live/received",
    "deliveryRemoteDir": "/sage/reports/live/forCNP",
    "manifestPath": "./journal_manifest.json",
    "connectTimeout": 30,
    "bannerTimeout": 30,
    "authTimeout": 30,
    "readTimeout": 120,
    "transferRetries": 3,
    "transferRetryDelay": 3,
    "keepaliveSeconds": 30
  },
  "options": {
    "localizeImages": true,
    "deobfuscateEmails": true,
    "delayMs": 500,
    "maxWorkers": 8,
    "retries": 3,
    "timeout": 30
  }
}